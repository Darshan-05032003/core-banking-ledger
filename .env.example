# Copy to .env and adjust for your machine. Never commit .env.
# docker compose reads this file for the database credentials; the application
# reads the same variables, falling back to these local defaults when unset.

# Active Spring profile: dev, test or prod
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (host port 5433 so it can run next to other local databases)
DB_NAME=ledger
DB_USERNAME=ledger
DB_PASSWORD=ledger
DB_URL=jdbc:postgresql://localhost:5433/ledger

# Kafka external listener
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# HTTP port of the application
SERVER_PORT=8082

# Accounts: four-digit branch code embedded in every account number, and the currency used when a request names none
APP_ACCOUNT_BRANCH_CODE=0001
APP_ACCOUNT_DEFAULT_CURRENCY=INR

# Ledger: how long a posting waits for a locked balance row before giving up (Spring duration)
APP_LEDGER_LOCK_TIMEOUT=3s

# Idempotency: an unfinished Idempotency-Key older than this may be taken over by a retry
APP_IDEMPOTENCY_IN_PROGRESS_TIMEOUT=2m

# Transfer limits (amounts in the account currency, two decimals)
APP_LIMITS_PER_TRANSACTION=500000.00
APP_LIMITS_DAILY=2000000.00

# Maker-checker: transfers above the threshold need approval; pending ones expire after this duration
APP_APPROVAL_THRESHOLD=200000.00
APP_APPROVAL_PENDING_EXPIRY=24h

# Interest: annual rate for savings accounts as a fraction, and the daily accrual schedule (Spring cron)
APP_INTEREST_SAVINGS_ANNUAL_RATE=0.0350
APP_INTEREST_ACCRUAL_CRON=0 30 0 * * *

# Security: JWT issuer claim, access token lifetime and per-user transfer rate limit
APP_SECURITY_JWT_ISSUER=core-banking-ledger
APP_SECURITY_JWT_ACCESS_TOKEN_TTL=15m
APP_SECURITY_RATE_LIMIT_TRANSFERS_PER_MINUTE=20

# RSA key pair that signs access tokens: PEM text (line breaks may be written as \n) or a
# location such as file:/run/secrets/jwt-private.pem. Required in prod; the dev and test
# profiles generate a throwaway pair at start-up when both are left empty. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
APP_SECURITY_JWT_PRIVATE_KEY=
APP_SECURITY_JWT_PUBLIC_KEY=

# Dev profile only: an ADMIN user seeded at start-up so the admin endpoints can be used on a
# fresh database. The hash is computed at start-up; the password is never stored in clear.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-before-starting
